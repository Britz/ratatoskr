{
  "name": "Ratatöskr MkDocs",
  "initializeCommand": "printf '%s' \"$(id -u)\" > .devcontainer/.local_uid && printf '%s' \"$(id -g)\" > .devcontainer/.local_gid",

  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "${localEnv:USER:vscode}"
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "pip install --user --upgrade pip && pip install --user -r requirements.txt",

  "mounts": [
    "source=${localEnv:HOME}/Documents/Privat/Reenactment,target=/workspaces/ratatoskr/Reenactment,type=bind,consistency=cached",
    "source=ratatoskr-claude-data,target=/home/${localEnv:USER:vscode}/.claude,type=volume",
    "source=/etc/localtime,target=/etc/localtime,type=bind,readonly"
  ],

  "containerEnv": {
    "TZ": "${localEnv:TZ}"
  },

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "MkDocs preview",
      "onAutoForward": "openPreview",
      "protocol": "http"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.vscode-yaml",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint",
        "bierner.markdown-mermaid",
        "MS-CEINTL.vscode-language-pack-de",
        "Anthropic.claude-code",
        "mathematic.vscode-pdf"
      ],
      "settings": {
        "yaml.schemas": {
          "https://squidfunk.github.io/mkdocs-material/schema.json": "mkdocs.yml"
        },
        "yaml.customTags": [
          "!!python/name:material.extensions.emoji.twemoji",
          "!!python/name:material.extensions.emoji.to_svg"
        ],
        "files.associations": {
          "mkdocs.yml": "yaml"
        },
        "[markdown]": {
          "files.trimTrailingWhitespace": false,
          "editor.wordWrap": "on"
        },
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },

  "remoteUser": "${localEnv:USER:vscode}"
}
